# === Earnings Call Agent — example env ===
# Copy to .env and fill in real values. Do NOT put real keys here.

FINNHUB_API_KEY="your-finnhub-key"
FINNHUB_WEBHOOK_SECRET="your-finnhub-webhook-secret"

API_NINJAS_KEY="your-api-ninjas-key"

GROQ_API_KEY="your-groq-key"
